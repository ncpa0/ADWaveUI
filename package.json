{
  "name": "adwaveui",
  "version": "0.4.1",
  "description": "Interactive Web Components inspired by the Gtk Adwaita theme.",
  "keywords": [
    "adwaita",
    "libadwaita",
    "gnome",
    "gtk",
    "ui",
    "css",
    "web components",
    "input",
    "selector",
    "slider",
    "switch"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ncpa0/ADWaveUI"
  },
  "license": "MIT",
  "author": {
    "name": "Szymon Bretner",
    "email": "szymonb21@gmail.com"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "./dist/esm/components/input/input": {
      "types": "./dist/types/components/input/input.d.ts",
      "default": "./dist/esm/components/input/input.mjs"
    },
    "./input": {
      "types": "./dist/types/components/input/input.d.ts",
      "default": "./dist/esm/components/input/input.mjs"
    },
    "./dist/esm/components/selector/selector": {
      "types": "./dist/types/components/selector/selector.d.ts",
      "default": "./dist/esm/components/selector/selector.mjs"
    },
    "./selector": {
      "types": "./dist/types/components/selector/selector.d.ts",
      "default": "./dist/esm/components/selector/selector.mjs"
    },
    "./dist/esm/components/slider/slider": {
      "types": "./dist/types/components/slider/slider.d.ts",
      "default": "./dist/esm/components/slider/slider.mjs"
    },
    "./slider": {
      "types": "./dist/types/components/slider/slider.d.ts",
      "default": "./dist/esm/components/slider/slider.mjs"
    },
    "./dist/esm/components/switch/switch": {
      "types": "./dist/types/components/switch/switch.d.ts",
      "default": "./dist/esm/components/switch/switch.mjs"
    },
    "./switch": {
      "types": "./dist/types/components/switch/switch.d.ts",
      "default": "./dist/esm/components/switch/switch.mjs"
    },
    "./dist/esm/components/calendar/calendar": {
      "types": "./dist/types/components/calendar/calendar.d.ts",
      "default": "./dist/esm/components/calendar/calendar.mjs"
    },
    "./calendar": {
      "types": "./dist/types/components/calendar/calendar.d.ts",
      "default": "./dist/esm/components/calendar/calendar.mjs"
    },
    "./bundle": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./dist/bundle/index": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/bundle/index.js"
    }
  },
  "main": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "fix:fmt": "dprint fmt './src/**/*'",
    "fix:lint": "oxlint --fix",
    "test:fmt": "dprint check './src/**/*'",
    "test:lint": "oxlint",
    "test:tsc": "tsc --noEmit",
    "build": "node ./scripts/build.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ncpa0cpl/vanilla-jsx": "0.0.1-alpha.54",
    "adwavecss": ">=0.4.0",
    "wc_toolkit": "^0.1.4"
  },
  "devDependencies": {
    "@ncpa0cpl/goserve": "^1.0.3",
    "@ncpa0cpl/nodepack": "^2.5.0",
    "@types/node": "^20.12.12",
    "dprint": "^0.64.1",
    "esbuild": "^0.28.2",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#0.0.1",
    "husky": "^8.0.3",
    "lightningcss": "^1.33.0",
    "node-os-walk": "^1.0.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.19"
}
